<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {% set fullTitle = (title + ' - ' if title) + 'Vio-lettres | Correction & Relecture professionnelles' %}
    <title>{{ fullTitle }}</title>
    <meta name="description" content="Correction de manuscrits et épreuves : orthographe, typographie, cohérence, fact-checking. Spécialité mangas, webtoons, romans, comics. Certifiée Le Robert niveau expert.">
    <meta property="og:title" content="{{ fullTitle }}">
    <meta property="og:description" content="Correction professionnelle de manuscrits et épreuves. Mangas, webtoons, romans, comics, artbooks, BD, essais.">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://violette.pogodev.com/">
    <meta name="twitter:card" content="summary_large_image">
    <link rel="icon" type="image/png" href="/public/favicon.png">
    <link rel="shortcut icon" type="image/png" href="/public/favicon.png">
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.js"></script>
    <script src="https://unpkg.com/@phosphor-icons/web"></script>
</head>
<body class="bg-cream text-gray-900 font-sans">
    {% include "header.njk" %}
    
    <main>
        {{ content | safe }}
    </main>

    {% include "footer.njk" %}
    
    <script>
        lucide.createIcons();
    </script>
</body>
</html>