<script>
    function sendSimpleEmail() {
        const nom = document.getElementById('nom').value;
        const email = document.getElementById('email').value;
        const sujet = document.getElementById('sujet').value;
        const message = document.getElementById('message').value;
        
        // Vérification des champs obligatoires
        if (!nom || !email || !sujet || !message) {
            alert('Veuillez remplir tous les champs obligatoires.');
            return;
        }
        
        // Construction du corps de l'email
        let body = `Bonjour Violette,\n\n`;
        body += `${message}\n\n`;
        body += `Cordialement,\n`;
        body += `${nom}\n`;
        body += `${email}`;
        
        // Encodage pour URL
        const encodedSubject = encodeURIComponent(sujet);
        const encodedBody = encodeURIComponent(body);
        
        // Génération du lien mailto
        const mailtoLink = `mailto:violette.pogoda@gmail.com?subject=${encodedSubject}&body=${encodedBody}`;
        
        // Ouverture du client mail
        window.location.href = mailtoLink;
    }
</script>