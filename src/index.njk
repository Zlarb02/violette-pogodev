<script>
    document.addEventListener('DOMContentLoaded', function() {
        const form = document.querySelector('form[role="form"]');
        const submitButton = form.querySelector('button[type="submit"]');
        
        // Validation en temps réel
        function validateField(field, errorElementId, validationFn, errorMessage) {
            const errorElement = document.getElementById(errorElementId);
            const isValid = validationFn(field.value);
            
            if (!isValid && field.value.trim() !== '') {
                errorElement.textContent = errorMessage;
                errorElement.classList.remove('hidden');
                field.setAttribute('aria-invalid', 'true');
                return false;
            } else {
                errorElement.textContent = '';
                errorElement.classList.add('hidden');
                field.setAttribute('aria-invalid', 'false');
                return true;
            }
        }
        
        // Validateurs
        const validators = {
            nom: (value) => value.trim().length >= 2,
            email: (value) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value),
            sujet: (value) => value.trim().length >= 3,
            message: (value) => value.trim().length >= 10
        };
        
        const errorMessages = {
            nom: 'Le nom doit contenir au moins 2 caractères',
            email: 'Veuillez entrer une adresse email valide',
            sujet: 'Le sujet doit contenir au moins 3 caractères',
            message: 'Le message doit contenir au moins 10 caractères'
        };
        
        // Ajouter la validation en temps réel
        ['nom', 'email', 'sujet', 'message'].forEach(fieldName => {
            const field = document.getElementById(fieldName);
            const errorElementId = fieldName + '-error';
            
            field.addEventListener('blur', () => {
                validateField(field, errorElementId, validators[fieldName], errorMessages[fieldName]);
            });
            
            field.addEventListener('input', () => {
                if (field.getAttribute('aria-invalid') === 'true') {
                    validateField(field, errorElementId, validators[fieldName], errorMessages[fieldName]);
                }
            });
        });
        
        // Soumission du formulaire
        form.addEventListener('submit', function(e) {
            e.preventDefault();
            
            const nom = document.getElementById('nom').value.trim();
            const email = document.getElementById('email').value.trim();
            const sujet = document.getElementById('sujet').value.trim();
            const message = document.getElementById('message').value.trim();
            
            // Validation simple des champs obligatoires
            if (!nom.trim() || !email.trim() || !sujet.trim() || !message.trim()) {
                alert('Veuillez remplir tous les champs obligatoires.');
                submitButton.disabled = false;
                submitButton.innerHTML = '<i data-lucide="send" class="w-5 h-5" aria-hidden="true"></i><span>Envoyer le message</span>';
                return;
            }
            
            // Validation email simple
            if (!email.includes('@') || !email.includes('.')) {
                alert('Veuillez entrer une adresse email valide.');
                submitButton.disabled = false;
                submitButton.innerHTML = '<i data-lucide="send" class="w-5 h-5" aria-hidden="true"></i><span>Envoyer le message</span>';
                return;
            }
            
            // Désactiver le bouton pendant l'envoi
            submitButton.disabled = true;
            submitButton.innerHTML = '<i data-lucide="loader-2" class="w-5 h-5 animate-spin" aria-hidden="true"></i><span>Envoi en cours...</span>';
            
            try {
                // Construction simple du corps de l'email
                let body = 'Bonjour Violette,\n\n';
                body += message + '\n\n';
                body += '---\n';
                body += 'Message envoyé depuis votre site web\n';
                body += 'Nom : ' + nom + '\n';
                body += 'Email : ' + email + '\n';
                body += 'Date : ' + new Date().toLocaleDateString('fr-FR');
                
                // Encodage simple et efficace
                const encodedSubject = encodeURIComponent('[Site Web] ' + sujet);
                const encodedBody = encodeURIComponent(body);
                
                // Création du lien mailto
                const mailtoLink = 'mailto:violette.pogoda@gmail.com?subject=' + encodedSubject + '&body=' + encodedBody;
                
                // Essayer plusieurs méthodes pour forcer l'ouverture du client mail
                try {
                    // Méthode 1 : window.open (souvent plus efficace pour mailto)
                    const newWindow = window.open(mailtoLink, '_blank');
                    
                    // Si la fenêtre s'ouvre mais reste vide, la fermer après un délai
                    if (newWindow) {
                        setTimeout(() => {
                            try {
                                newWindow.close();
                            } catch (e) {
                                // Ignore les erreurs de fermeture
                            }
                        }, 500);
                    }
                } catch (e) {
                    // Fallback : méthode classique
                    window.location.href = mailtoLink;
                }
                
                
                // Afficher un message de confirmation à l'utilisateur
                setTimeout(() => {
                    const confirmMessage = document.createElement('div');
                    confirmMessage.className = 'bg-blue-100 border border-blue-400 text-blue-700 px-4 py-3 rounded-xl mb-4';
                    confirmMessage.setAttribute('role', 'alert');
                    confirmMessage.innerHTML = `
                        <strong>Client mail en cours d'ouverture...</strong><br>
                        Si votre client mail ne s'ouvre pas, vous pouvez copier cette adresse : 
                        <strong>violette.pogoda@gmail.com</strong><br>
                        <small>Sujet : [Site Web] ${sujet}</small>
                    `;
                    form.insertBefore(confirmMessage, form.firstChild);
                    
                    // Supprimer le message après 10 secondes
                    setTimeout(() => confirmMessage.remove(), 10000);
                }, 100);
                
            } catch (error) {
                console.error('Erreur lors de l\'envoi:', error);
                alert('Erreur : Veuillez contacter directement violette.pogoda@gmail.com avec le sujet : [Site Web] ' + sujet);
            }
            
            // Réactiver le bouton après un court délai
            setTimeout(() => {
                submitButton.disabled = false;
                submitButton.innerHTML = '<i data-lucide="send" class="w-5 h-5" aria-hidden="true"></i><span>Envoyer le message</span>';
                lucide.createIcons(); // Recréer les icônes
            }, 1000);
        });
    });
</script>