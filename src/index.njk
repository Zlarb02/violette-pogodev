---
layout: base.njk
title: Accueil
---
<section class="hero-section min-h-screen flex items-center pt-20 pb-8 relative overflow-hidden" 
         role="banner" 
         aria-label="Section d'accueil"
         id="accueil">
    <!-- Fond avec image bibliothèque (desktop uniquement) -->
    <div class="hero-background absolute inset-0">
        <!-- Image de fond pour desktop -->
        <img src="/public/bibliotheque.jpeg" 
             alt="Rayonnages de bibliothèque" 
             class="hidden lg:block absolute inset-0 w-full h-full object-cover opacity-50 mix-blend-multiply pointer-events-none scale-x-[-1]" 
             loading="lazy" />
        
        <!-- Overlay gradient pour desktop -->
        <div class="hidden lg:block absolute inset-0 hero-gradient-overlay"></div>
        
        <!-- Fond simple pour mobile/tablet -->
        <div class="lg:hidden absolute inset-0 hero-mobile-gradient"></div>
    </div>
    
    <!-- Contenu principal -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="hero-grid grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 xl:gap-16 items-center">
            
            <!-- Section gauche : Contenu textuel -->
            <div class="hero-content order-2 lg:order-1 space-y-8 text-center lg:text-left">
                
                <!-- Logo visible uniquement sur desktop -->
                <div class="hidden lg:block">
                    <img src="/public/logo.png" 
                         alt="Logo Vio-lettres" 
                         class="h-32 xl:h-40 w-auto object-contain drop-shadow-lg" />
                </div>
                
                <!-- Titre principal -->
                <div class="space-y-6">
                    <h1 class="hero-title font-serif leading-tight text-violet-dark whitespace-nowrap">
                        Bienvenue chez 
                        <span class="hero-brand text-violet font-bold bg-gradient-to-r from-violet-light/10 to-white/80 rounded-2xl shadow-lg border border-violet/15 inline-block">
                            Vio-lettres
                        </span> !
                    </h1>
                    
                    <p class="hero-description text-gray-700 text-lg sm:text-xl lg:text-xl xl:text-2xl leading-relaxed font-light max-w-2xl mx-auto lg:mx-0">
                        Là où manuscrits et épreuves sont peaufinés, caractère après caractère, bulle après bulle, pour se métamorphoser en livres prêts à rencontrer leurs lecteurs.
                    </p>
                </div>
                
                <!-- Boutons d'action -->
                <div class="hero-buttons flex flex-col sm:flex-row gap-4 sm:justify-center lg:justify-start">
                    <a href="#services" 
                       class="hero-cta-primary group inline-flex items-center justify-center gap-3 bg-violet text-white font-semibold px-8 py-4 rounded-2xl transition-all duration-300 shadow-lg hover:shadow-xl hover:bg-violet-dark hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-violet/50"
                       aria-label="Découvrir mes services de correction">
                        <span>Découvrir mes services</span>
                    </a>
                    
                    <a href="#contact" 
                       class="hero-cta-secondary group inline-flex items-center justify-center gap-3 bg-white text-violet-dark font-semibold px-8 py-4 rounded-2xl transition-all duration-300 shadow-lg hover:shadow-xl border-2 border-violet/20 hover:border-violet/40 hover:-translate-y-1 focus:outline-none focus:ring-2 focus:ring-violet/50"
                       aria-label="Me contacter pour un devis">
                        <i data-lucide="send" class="w-5 h-5 group-hover:scale-110 transition-transform duration-300" aria-hidden="true"></i>
                        <span>Me contacter</span>
                    </a>
                </div>
            </div>
            
            <!-- Section droite : Photo de profil -->
            <div class="hero-photo order-1 lg:order-2 flex justify-center lg:justify-end">
                <div class="photo-container relative">
                    <!-- Effet d'éclairage -->
                    <div class="absolute -inset-4 bg-gradient-radial from-violet/8 via-violet/3 to-transparent rounded-full blur-2xl"></div>
                    
                    <!-- Cadre photo interactif -->
                    <a href="#qui-suis-je" 
                       class="photo-frame group relative block bg-white/90 backdrop-blur-sm p-3 rounded-3xl shadow-2xl border border-violet/10 transition-all duration-300 hover:scale-105 hover:shadow-3xl focus:outline-none focus:ring-2 focus:ring-violet/50"
                       aria-label="En savoir plus sur Violette Pogoda - Voir la section Qui suis-je">
                        
                        <div class="photo-wrapper relative w-56 h-64 sm:w-64 sm:h-72 lg:w-72 lg:h-80 rounded-2xl overflow-hidden">
                            <!-- Photo principale -->
                            <img src="/public/photodeprofil.webp" 
                                 alt="Portrait professionnel de Violette Pogoda, correctrice indépendante, souriante" 
                                 class="w-full h-full object-cover object-top transition-all duration-500 group-hover:brightness-50" 
                                 loading="lazy"
                                 width="288"
                                 height="320" />
                            
                            <!-- Overlay interactif "Qui suis-je ?" -->
                            <div class="photo-overlay absolute inset-0 bg-violet/95 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-500" aria-hidden="true">
                                <div class="text-center text-white p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                                    <div class="mb-4">
                                        <i data-lucide="user" class="w-12 h-12 mx-auto mb-3 transform scale-75 group-hover:scale-100 transition-transform duration-500" aria-hidden="true"></i>
                                    </div>
                                    <h3 class="text-xl font-bold mb-2">Qui suis-je ?</h3>
                                    <p class="text-sm opacity-90">Découvrez mon parcours et mes atouts</p>
                                    <div class="mt-4 w-8 h-0.5 bg-white/60 mx-auto transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500 delay-200" aria-hidden="true"></div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
            
        </div>
    </div>
</section>

<!-- Qui suis-je / Parcours -->
<section id="qui-suis-je" class="py-16 lg:py-24 bg-gradient-to-b from-white to-violet-light/20">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12 lg:mb-16">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-violet-dark mb-4">Qui suis-je ?</h2>
            <div class="w-24 h-1 bg-violet mx-auto rounded-full"></div>
        </div>
        
        <!-- Livre ouvert : Mon parcours / Mes atouts -->
        <div class="flex justify-center">
            <div class="flex flex-col lg:flex-row w-full max-w-5xl lg:h-[700px] relative">
                <!-- Page gauche : Mon parcours -->
                <div class="w-full lg:w-1/2 min-h-[500px] lg:h-[700px] bg-white rounded-t-3xl lg:rounded-l-3xl lg:rounded-tr-none p-6 lg:p-10 shadow-xl border border-b-0 lg:border-b lg:border-r-0 border-violet/10 relative transform lg:-rotate-1 hover:rotate-0 transition-transform duration-300 overflow-auto">
                    <!-- Effet de reliure sur le bord droit -->
                    <div class="absolute right-0 top-0 bottom-0 w-6 bg-gradient-to-r from-transparent via-violet/5 to-violet/10 pointer-events-none"></div>
                    <div class="absolute right-1 top-4 bottom-4 w-px bg-violet/20"></div>
                    <div class="absolute right-2 top-8 bottom-8 w-px bg-violet/10"></div>
                    
                    <h3 class="text-2xl font-semibold mb-6 text-violet-dark flex items-center gap-3">
                        <div class="flex items-center justify-center w-12 h-12 bg-violet/10 rounded-xl">
                            <i data-lucide="briefcase" class="text-violet w-6 h-6"></i>
                        </div>
                        Mon parcours
                    </h3>
                    <div class="space-y-4 text-gray-700 leading-relaxed lg:pr-6">
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p><strong class="text-violet-dark">Correctrice indépendante</strong> depuis novembre 2024, j'ai déjà eu le plaisir de travailler avec Mana Books, Manga Nova, Ki-oon, Kbooks et Kana, et je souhaite aujourd'hui élargir mes horizons.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p>J'ai terminé la <strong class="text-violet-dark">formation de lecteur-correcteur</strong> de l'EFLC en avril 2024 et je suis certifiée Le Robert (niveau expert).</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p>Cela vient compléter plus de dix ans d'expérience comme <strong class="text-violet-dark">assistante éditoriale</strong> : d'abord dans le secteur scolaire chez Nathan et Hatier, puis six ans chez Mana Books, avec des projets variés allant des mangas aux romans, en passant par les comics, webtoons, artbooks et livres de cuisine.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p>Avant Mana Books, j'ai effectué des travaux de <strong class="text-violet-dark">lectrice</strong> : premier tri des manuscrits reçus par Le Bélial' pendant près d'un an, et rédaction de quelques fiches de lecture pour Albin Michel Imaginaire.</p>
                        </div>
                    </div>
                </div>
                
                <!-- Page droite : Mes atouts -->
                <div class="w-full lg:w-1/2 min-h-[500px] lg:h-[700px] bg-white rounded-b-3xl lg:rounded-r-3xl lg:rounded-bl-none p-6 lg:p-10 shadow-xl border border-t-0 lg:border-t lg:border-l-0 border-violet/10 relative transform lg:rotate-1 hover:rotate-0 transition-transform duration-300 overflow-auto">
                    <!-- Effet de reliure sur le bord gauche -->
                    <div class="absolute left-0 top-0 bottom-0 w-6 bg-gradient-to-l from-transparent via-violet/5 to-violet/10 pointer-events-none"></div>
                    <div class="absolute left-1 top-4 bottom-4 w-px bg-violet/20"></div>
                    <div class="absolute left-2 top-8 bottom-8 w-px bg-violet/10"></div>
                    
                    <h3 class="text-2xl font-semibold mb-6 text-violet-dark flex items-center gap-3">
                        <div class="flex items-center justify-center w-12 h-12 bg-violet/10 rounded-xl">
                            <i class="ph-bold ph-club text-violet text-2xl"></i>
                        </div>
                        Mes atouts
                    </h3>
                    <div class="space-y-4 text-gray-700 leading-relaxed lg:pl-6">
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p>Ma connaissance des règles de la langue française et de la typographie ainsi que mon regard entraîné à la relecture me permettent de <strong class="text-violet-dark">repérer efficacement les fautes et les incohérences</strong>.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p>Je pratique le <strong class="text-violet-dark">doute actif</strong> : je me demande le plus souvent possible si tel mot est bien orthographié, si telle phrase est bien construite, ou si telle information est correcte.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p>De mon <strong class="text-violet-dark">expérience d'assistante éditoriale</strong>, j'ai gardé trois forces : comprendre les attentes des éditeurs, travailler avec rigueur et organisation, et enrichir ma pratique grâce à la collaboration avec d'autres correcteurs.</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p><strong class="text-violet-dark">Passionnée par l'imaginaire</strong> sous toutes ses formes – livres, jeux vidéo, films, séries –, je veille à la cohérence interne des œuvres que je relis, et à celle de l'univers global lorsque le texte appartient à un monde étendu.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services -->
<section id="services" class="py-16 lg:py-24 bg-gradient-to-b from-violet-light/30 to-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12 lg:mb-16">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-violet-dark mb-4">Services proposés</h2>
            <div class="w-24 h-1 bg-violet mx-auto rounded-full"></div>
        </div>
        
        <!-- Livre ouvert : Pour qui / Quelles prestations -->
        <div class="flex justify-center mb-12 lg:mb-16">
            <div class="flex flex-col lg:flex-row w-full max-w-5xl lg:h-[550px] relative">
                <!-- Page gauche : Pour qui -->
                <div class="w-full lg:w-1/2 min-h-[400px] lg:h-[550px] bg-white rounded-t-3xl lg:rounded-l-3xl lg:rounded-tr-none p-6 lg:p-10 shadow-xl border border-b-0 lg:border-b lg:border-r-0 border-violet/10 relative transform lg:-rotate-1 hover:rotate-0 transition-transform duration-300 overflow-auto">
                    <!-- Effet de reliure sur le bord droit -->
                    <div class="absolute right-0 top-0 bottom-0 w-6 bg-gradient-to-r from-transparent via-violet/5 to-violet/10 pointer-events-none"></div>
                    <div class="absolute right-1 top-4 bottom-4 w-px bg-violet/20"></div>
                    <div class="absolute right-2 top-8 bottom-8 w-px bg-violet/10"></div>
                    
                    <h3 class="text-2xl font-serif mb-6 text-violet-dark flex items-center gap-3">
                        <div class="flex items-center justify-center w-12 h-12 bg-violet/10 rounded-xl">
                            <i data-lucide="users" class="text-violet w-7 h-7"></i>
                        </div>
                        Pour qui ?
                    </h3>
                    <div class="space-y-4 text-gray-700 leading-relaxed lg:pr-6">
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p><strong class="text-violet-dark">Auteurs</strong> qui souhaitent faire corriger leur manuscrit avant publication (en autoédition ou avant envoi aux éditeurs)</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p><strong class="text-violet-dark">Maisons d'édition</strong> (romans, mangas, webtoons, comics, artbooks, BD, livres de cuisine, essais, scolaire et parascolaire)</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p><strong class="text-violet-dark">Agences de correction</strong></p>
                        </div>

                    </div>
                </div>
                
                <!-- Page droite : Quelles prestations -->
                <div class="w-full lg:w-1/2 min-h-[400px] lg:h-[550px] bg-white rounded-b-3xl lg:rounded-r-3xl lg:rounded-bl-none p-6 lg:p-10 shadow-xl border border-t-0 lg:border-t lg:border-l-0 border-violet/10 relative transform lg:rotate-1 hover:rotate-0 transition-transform duration-300 overflow-auto">
                    <!-- Effet de reliure sur le bord gauche -->
                    <div class="absolute left-0 top-0 bottom-0 w-6 bg-gradient-to-l from-transparent via-violet/5 to-violet/10 pointer-events-none"></div>
                    <div class="absolute left-1 top-4 bottom-4 w-px bg-violet/20"></div>
                    <div class="absolute left-2 top-8 bottom-8 w-px bg-violet/10"></div>
                    
                    <h3 class="text-2xl font-serif mb-6 text-violet-dark flex items-center gap-3">
                        <div class="flex items-center justify-center w-12 h-12 bg-violet/10 rounded-xl">
                            <i data-lucide="file-edit" class="text-violet w-7 h-7"></i>
                        </div>
                        Quelles prestations&nbsp;?
                    </h3>
                    <div class="space-y-4 text-gray-700 leading-relaxed lg:pl-6">
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p><strong class="text-violet-dark">Correction de manuscrit</strong> (Word) : orthographe, typographie, grammaire, conjugaison, syntaxe, cohérence, vérification factuelle, détection des répétitions et propositions de reformulation</p>
                        </div>
                        <div class="flex items-start gap-3">
                            <div class="w-2 h-2 bg-violet rounded-full mt-2 flex-shrink-0"></div>
                            <p><strong class="text-violet-dark">Correction d'épreuves</strong> (PDF ou InDesign) : même chose que pour la correction d'un manuscrit + vérification du lettrage/de la maquette</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Tarifs -->
<section id="tarifs" class="py-16 lg:py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12 lg:mb-16">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-violet-dark mb-4">Tarifs</h2>
            <div class="w-24 h-1 bg-violet mx-auto rounded-full"></div>
        </div>
        
        <div class="grid md:grid-cols-2 gap-12 max-w-4xl mx-auto">
            <div class="relative group">
                <div class="absolute inset-0 bg-gradient-to-br from-violet/20 to-violet-light/30 rounded-2xl blur transform group-hover:scale-105 transition-transform duration-300"></div>
                <div class="relative bg-gradient-to-br from-violet/10 to-violet-light/20 rounded-2xl p-8 border border-violet/20 shadow-lg">
                    <div class="flex items-center gap-3 mb-4">
                        <i data-lucide="message-circle" class="text-violet w-8 h-8"></i>
                        <h3 class="text-2xl font-serif text-violet-dark">Mangas, webtoons, comics</h3>
                    </div>
                    <div class="mb-4">
                        <p class="text-5xl font-bold text-violet-dark">140 €</p>
                        <p class="text-lg text-gray-600 font-medium">par volume</p>
                    </div>
                    <p class="text-sm text-gray-600 leading-relaxed">Le montant peut être négocié, notamment en cas de pagination élevée.</p>
                </div>
            </div>
            
            <div class="relative group">
                <div class="absolute inset-0 bg-gradient-to-br from-violet-light/20 to-violet/30 rounded-2xl blur transform group-hover:scale-105 transition-transform duration-300"></div>
                <div class="relative bg-white rounded-2xl p-8 border border-violet/20 shadow-lg">
                    <div class="flex items-center gap-3 mb-4">
                        <i data-lucide="book" class="text-violet w-8 h-8"></i>
                        <h3 class="text-2xl font-serif text-violet-dark">Autres livres</h3>
                    </div>
                    <div class="mb-4">
                        <p class="text-5xl font-bold text-violet-dark">2,50 €</p>
                        <p class="text-lg text-gray-600 font-medium">pour 1000 signes</p>
                    </div>
                    <p class="text-sm text-gray-600 leading-relaxed">Le montant peut être négocié en fonction de vos besoins.</p>
                </div>
            </div>
        </div>
        
        <div class="text-center mt-12">
            <a href="#contact" class="inline-flex items-center gap-2 bg-violet hover:bg-violet-dark text-white font-semibold px-8 py-4 rounded-xl transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1">
                <i data-lucide="send" class="w-5 h-5"></i>
                Me contacter
            </a>
        </div>
    </div>
</section>

<!-- Contact -->
<section id="contact" class="py-16 lg:py-24 bg-gradient-to-br from-violet-light/30 via-cream/40 to-violet-light/20">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12 lg:mb-16">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-violet-dark mb-4">Contact</h2>
            <div class="w-24 h-1 bg-violet mx-auto rounded-full mb-6"></div>
            <p class="text-lg sm:text-xl text-violet-dark max-w-2xl mx-auto leading-relaxed">
                Vous souhaitez me confier un projet ? Vous avez des questions ? Parlons-en. 🙂
            </p>
        </div>
        
        <!-- Formulaire de contact simple -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 lg:p-12 shadow-2xl border border-violet/10 max-w-4xl mx-auto">
            <form class="space-y-6" role="form" aria-label="Formulaire de contact">
                <div class="grid md:grid-cols-2 gap-6">
                    <!-- Nom et Prénom -->
                    <div class="form-group">
                        <label for="nom" class="block text-sm font-medium text-violet-dark mb-2">
                            <i data-lucide="user" class="w-4 h-4 inline mr-2" aria-hidden="true"></i>
                            Nom et Prénom *
                        </label>
                        <input type="text" id="nom" name="nom" required
                               class="w-full px-4 py-3 border border-violet/20 rounded-xl focus:ring-2 focus:ring-violet/20 focus:border-violet focus:outline-none transition-colors duration-200"
                               placeholder="Votre nom complet"
                               aria-describedby="nom-error"
                               autocomplete="name">
                        <div id="nom-error" class="text-red-600 text-sm mt-1 hidden" role="alert"></div>
                    </div>
                    
                    <!-- Email -->
                    <div class="form-group">
                        <label for="email" class="block text-sm font-medium text-violet-dark mb-2">
                            <i data-lucide="mail" class="w-4 h-4 inline mr-2" aria-hidden="true"></i>
                            Email *
                        </label>
                        <input type="email" id="email" name="email" required
                               class="w-full px-4 py-3 border border-violet/20 rounded-xl focus:ring-2 focus:ring-violet/20 focus:border-violet focus:outline-none transition-colors duration-200"
                               placeholder="votre.email@exemple.com"
                               aria-describedby="email-error"
                               autocomplete="email">
                        <div id="email-error" class="text-red-600 text-sm mt-1 hidden" role="alert"></div>
                    </div>
                </div>
                
                <!-- Sujet -->
                <div class="form-group">
                    <label for="sujet" class="block text-sm font-medium text-violet-dark mb-2">
                        <i data-lucide="tag" class="w-4 h-4 inline mr-2" aria-hidden="true"></i>
                        Sujet *
                    </label>
                    <input type="text" id="sujet" name="sujet" required
                           class="w-full px-4 py-3 border border-violet/20 rounded-xl focus:ring-2 focus:ring-violet/20 focus:border-violet focus:outline-none transition-colors duration-200"
                           placeholder="Objet de votre demande"
                           aria-describedby="sujet-error">
                    <div id="sujet-error" class="text-red-600 text-sm mt-1 hidden" role="alert"></div>
                </div>
                
                <!-- Message -->
                <div class="form-group">
                    <label for="message" class="block text-sm font-medium text-violet-dark mb-2">
                        <i data-lucide="message-square" class="w-4 h-4 inline mr-2" aria-hidden="true"></i>
                        Message *
                    </label>
                    <textarea id="message" name="message" rows="6" required
                              class="w-full px-4 py-3 border border-violet/20 rounded-xl focus:ring-2 focus:ring-violet/20 focus:border-violet focus:outline-none transition-colors duration-200 resize-none"
                              placeholder="Décrivez votre projet, vos besoins, vos questions..."
                              aria-describedby="message-error message-hint">
                    </textarea>
                    <div id="message-hint" class="text-gray-500 text-sm mt-1">Minimum 10 caractères</div>
                    <div id="message-error" class="text-red-600 text-sm mt-1 hidden" role="alert"></div>
                </div>
                
                <!-- Bouton d'envoi -->
                <div class="text-center pt-6">
                    <button type="submit" 
