<!-- Contact -->
<section id="contact" class="py-16 lg:py-24 bg-gradient-to-br from-violet-light/30 via-cream/40 to-violet-light/20">
    <div class="max-w-6xl mx-auto px-4">
        <div class="text-center mb-12 lg:mb-16">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-serif text-violet-dark mb-4">Contact</h2>
            <div class="w-24 h-1 bg-violet mx-auto rounded-full mb-6"></div>
            <p class="text-lg sm:text-xl text-violet-dark max-w-2xl mx-auto leading-relaxed">
                Vous souhaitez me confier un projet ? Vous avez des questions ? Parlons-en. 🙂
            </p>
        </div>
        
        <!-- Formulaire de contact simple -->
        <div class="bg-white rounded-3xl p-6 sm:p-8 lg:p-12 shadow-2xl border border-violet/10 max-w-4xl mx-auto">
            <div class="space-y-6">
                <div class="grid md:grid-cols-2 gap-6">
                    <!-- Nom et Prénom -->
                    <div class="form-group">
                        <label for="nom" class="block text-sm font-medium text-violet-dark mb-2">
                            <i data-lucide="user" class="w-4 h-4 inline mr-2"></i>
                            Nom et Prénom *
                        </label>
                        <input type="text" id="nom" name="nom" required
                               class="w-full px-4 py-3 border border-violet/20 rounded-xl focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors duration-200"
                               placeholder="Votre nom complet">
                    </div>
                    
                    <!-- Email -->
                    <div class="form-group">
                        <label for="email" class="block text-sm font-medium text-violet-dark mb-2">
                            <i data-lucide="mail" class="w-4 h-4 inline mr-2"></i>
                            Email *
                        </label>
                        <input type="email" id="email" name="email" required
                               class="w-full px-4 py-3 border border-violet/20 rounded-xl focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors duration-200"
                               placeholder="votre.email@exemple.com">
                    </div>
                </div>
                
                <!-- Sujet -->
                <div class="form-group">
                    <label for="sujet" class="block text-sm font-medium text-violet-dark mb-2">
                        <i data-lucide="tag" class="w-4 h-4 inline mr-2"></i>
                        Sujet *
                    </label>
                    <input type="text" id="sujet" name="sujet" required
                           class="w-full px-4 py-3 border border-violet/20 rounded-xl focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors duration-200"
                           placeholder="Objet de votre demande">
                </div>
                
                <!-- Message -->
                <div class="form-group">
                    <label for="message" class="block text-sm font-medium text-violet-dark mb-2">
                        <i data-lucide="message-square" class="w-4 h-4 inline mr-2"></i>
                        Message *
                    </label>
                    <textarea id="message" name="message" rows="6" required
                              class="w-full px-4 py-3 border border-violet/20 rounded-xl focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors duration-200 resize-none"
                              placeholder="Décrivez votre projet, vos besoins, vos questions..."></textarea>
                </div>
                
                <!-- Pièce jointe -->
                <div class="form-group">
                    <label for="piece-jointe" class="block text-sm font-medium text-violet-dark mb-2">
                        <i data-lucide="paperclip" class="w-4 h-4 inline mr-2"></i>
                        Pièce jointe (optionnel)
                    </label>
                    <input type="file" id="piece-jointe" name="piece-jointe"
                           class="w-full px-4 py-3 border border-violet/20 rounded-xl focus:ring-2 focus:ring-violet/20 focus:border-violet transition-colors duration-200 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-violet/10 file:text-violet hover:file:bg-violet/20">
                    <p class="text-xs text-gray-500 mt-2">Formats acceptés : PDF, DOC, DOCX, TXT (Max 10 Mo)</p>
                </div>
                
                <!-- Bouton d'envoi -->
                <div class="text-center pt-6">
                    <button type="button" onclick="sendSimpleEmail()" 
                            class="inline-flex items-center gap-3 bg-violet hover:bg-violet-dark text-white font-semibold px-8 py-4 rounded-2xl transition-all duration-300 shadow-lg hover:shadow-xl transform hover:-translate-y-1">
                        <i data-lucide="send" class="w-5 h-5"></i>
                        <span>Envoyer le message</span>
                    </button>
                    
