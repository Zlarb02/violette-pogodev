<!-- Contact -->
<section id="contact" class="py-24 bg-gradient-to-b from-violet-light/30 to-cream relative">
    <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-3xl md:text-4xl font-serif text-center mb-12 text-violet-dark">Contact</h2>
        <p class="text-center max-w-2xl mx-auto text-gray-700 mb-10">Un projet, un manuscrit, une série de tomes ou des épreuves à rendre rapidement ? Parlons-en.</p>
        <form name="contact" method="POST" data-netlify="true" class="grid gap-6 md:grid-cols-2 bg-white/80 backdrop-blur-sm p-8 rounded-2xl shadow-lg border border-violet/10">
            <input type="hidden" name="form-name" value="contact" />
            <div class="md:col-span-1">
                <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Nom *</label>
                <input required type="text" id="name" name="name" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-violet focus:border-violet outline-none bg-white/70" />
            </div>
            <div class="md:col-span-1">
                <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                <input required type="email" id="email" name="email" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-violet focus:border-violet outline-none bg-white/70" />
            </div>
            <div class="md:col-span-2">
                <label for="type" class="block text-sm font-medium text-gray-700 mb-1">Type de projet</label>
                <select id="type" name="type" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-violet focus:border-violet outline-none bg-white/70">
                    <option>Manuscrit</option>
                    <option>Épreuves PDF</option>
                    <option>Épreuves InDesign</option>
                    <option>Manga / Webtoon / Comics</option>
                    <option>Autre</option>
                </select>
            </div>
            <div class="md:col-span-2">
                <label for="message" class="block text-sm font-medium text-gray-700 mb-1">Message *</label>
                <textarea required id="message" name="message" rows="5" class="w-full px-4 py-2.5 rounded-lg border border-gray-300 focus:ring-2 focus:ring-violet focus:border-violet outline-none bg-white/70"></textarea>
            </div>
            <div class="md:col-span-2 flex flex-col sm:flex-row items-center justify-between gap-4">
                <p class="text-xs text-gray-500">Je réponds généralement sous 24h ouvrées.</p>
                <button type="submit" class="inline-flex justify-center bg-violet hover:bg-violet-dark text-white font-medium px-8 py-3 rounded-lg transition-colors shadow">
                    Envoyer la demande
                </button>
            </div>
        </form>
    </div>
</section>

