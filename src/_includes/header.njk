<header class="fixed w-full bg-white/95 backdrop-blur-md shadow-sm z-50 border-b border-violet/5">
    <div class="max-w-7xl mx-auto px-4">
        <nav class="flex items-center justify-between h-24">
            <!-- Logo et identité -->
            <a href="/" class="flex items-center gap-4 py-2 z-50 relative">
                <img src="/public/logo.png" alt="Vio-lettres" class="h-20 w-auto object-contain" loading="lazy" />
                <div class="block">
                    <p class="text-violet-dark font-semibold text-lg leading-tight">Violette Pogoda</p>
                    <p class="text-violet text-sm font-medium">Correctrice indépendante</p>
                </div>
            </a>
            
            <!-- Navigation desktop -->
            <ul class="hidden md:flex items-center space-x-8 text-sm font-medium">
                <li><a href="/#qui-suis-je" class="nav-link">Qui suis-je ?</a></li>
                <li><a href="/#services" class="nav-link">Services</a></li>
                <li><a href="/#tarifs" class="nav-link">Tarifs</a></li>
            </ul>
            
            <!-- Bouton contact desktop -->
            <a href="/#contact" class="hidden md:inline-flex items-center gap-2 bg-violet text-white px-5 py-2.5 rounded-xl hover:bg-violet-dark transition-all duration-300 text-sm font-medium shadow-sm hover:shadow-md">
                <i data-lucide="send" class="w-4 h-4"></i>
                Me contacter
            </a>
            
            <!-- Bouton menu hamburger mobile -->
            <button class="md:hidden relative z-50 w-10 h-10 flex items-center justify-center rounded-lg hover:bg-violet/5 transition-colors focus:outline-none focus:ring-2 focus:ring-violet/50" 
                    id="mobile-menu-button"
                    aria-label="Ouvrir le menu de navigation"
                    aria-expanded="false"
                    aria-controls="mobile-menu">
                <div class="hamburger-icon">
                    <span class="hamburger-line" aria-hidden="true"></span>
                    <span class="hamburger-line" aria-hidden="true"></span>
                    <span class="hamburger-line" aria-hidden="true"></span>
                </div>
            </button>
        </nav>
    </div>
    
    <!-- Menu mobile -->
    <div class="md:hidden fixed inset-0 opacity-0 invisible transition-all duration-300 z-40" 
         id="mobile-menu-overlay"
         aria-hidden="true"
         style="background-color: rgba(0, 0, 0, 0.2); backdrop-filter: blur(4px);">
        <div class="absolute top-24 left-0 right-0 transform -translate-y-full transition-transform duration-300" 
             id="mobile-menu"
             role="dialog"
             aria-labelledby="mobile-menu-button"
             style="background-color: rgba(255, 255, 255, 0.98); backdrop-filter: blur(12px); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); border-bottom: 1px solid rgba(139, 122, 168, 0.1);">
            <nav class="px-4 py-6" aria-label="Navigation mobile">
                <ul class="space-y-3 mb-6" role="list">
                    <li role="listitem">
                        <a href="/#qui-suis-je" class="mobile-nav-link" tabindex="-1">
                            Qui suis-je ?
                        </a>
                    </li>
                    <li role="listitem">
                        <a href="/#services" class="mobile-nav-link" tabindex="-1">
                            Services
                        </a>
                    </li>
                    <li role="listitem">
                        <a href="/#tarifs" class="mobile-nav-link" tabindex="-1">
                            Tarifs
                        </a>
                    </li>
                </ul>
                
                <div class="pt-4 border-t border-violet/5">
                    <a href="/#contact" 
                       class="w-full inline-flex items-center justify-center gap-2 bg-violet text-white px-6 py-3 rounded-xl hover:bg-violet-dark focus:outline-none focus:ring-2 focus:ring-violet/50 transition-all duration-300 font-medium shadow-sm"
                       tabindex="-1">
                        <i data-lucide="send" class="w-4 h-4" aria-hidden="true"></i>
                        Me contacter
                    </a>
                </div>
            </nav>
        </div>
    </div>
</header>

<style>
    .nav-link { 
        color: #374151;
        transition: all 0.3s ease;
        position: relative;
    }
    .nav-link:hover {
        color: #4B3B65;
    }
    .nav-link:hover::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        right: 0;
        height: 2px;
        background: linear-gradient(90deg, #8B7AA8, #4B3B65);
        border-radius: 1px;
    }
    
    /* Styles épurés pour les liens de navigation mobile */
    .mobile-nav-link {
        display: block;
        color: #374151;
        padding: 1rem 1.25rem;
        border-radius: 0.75rem;
        transition: all 0.3s ease;
        font-weight: 500;
        text-decoration: none;
        border: 1px solid rgba(139, 122, 168, 0.08);
        background: rgba(255, 255, 255, 0.7);
    }
    
    .mobile-nav-link:hover {
        color: #4B3B65;
        background: rgba(139, 122, 168, 0.05);
        border-color: rgba(139, 122, 168, 0.12);
    }
    
    /* Hamburger animation */
    .hamburger-icon {
        width: 1.25rem;
        height: 1rem;
        position: relative;
    }
    .hamburger-line {
        position: absolute;
        left: 0;
        width: 100%;
        height: 2px;
        background-color: #4B3B65;
        transition: all 0.3s ease-in-out;
        border-radius: 1px;
    }
    .hamburger-line:nth-child(1) { top: 0; }
    .hamburger-line:nth-child(2) { top: 50%; transform: translateY(-50%); }
    .hamburger-line:nth-child(3) { bottom: 0; }
    
    /* Animation quand le menu est ouvert */
    .menu-open .hamburger-line:nth-child(1) {
        transform: rotate(45deg);
        top: 50%;
        margin-top: -1px;
    }
    .menu-open .hamburger-line:nth-child(2) {
        opacity: 0;
    }
    .menu-open .hamburger-line:nth-child(3) {
        transform: rotate(-45deg);
        bottom: 50%;
        margin-bottom: -1px;
    }
    
    /* États du menu mobile */
    .mobile-menu-open #mobile-menu-overlay {
        opacity: 1;
        visibility: visible;
    }
    .mobile-menu-open #mobile-menu {
        transform: translateY(0);
    }
    
    /* Styles supplémentaires pour le menu mobile */
    #mobile-menu-overlay {
        /* Fallback pour navigateurs sans backdrop-filter */
        background: rgba(0, 0, 0, 0.3);
    }
    
    #mobile-menu {
        /* Fallback pour navigateurs sans backdrop-filter */
        background: #ffffff;
        border: 1px solid rgba(139, 122, 168, 0.1);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }
    
    /* Support moderne avec backdrop-filter */
    @supports (backdrop-filter: blur(4px)) {
        #mobile-menu-overlay {
            background: rgba(0, 0, 0, 0.2);
        }
        
        #mobile-menu {
            background: rgba(255, 255, 255, 0.98);
        }
    }
    
    /* Animation d'entrée du menu */
    .mobile-menu-open #mobile-menu {
        animation: menuSlideIn 0.4s ease-out forwards;
    }
    
    @keyframes menuSlideIn {
        from {
            transform: translateY(-100%);
            opacity: 0;
        }
        to {
            transform: translateY(0);
            opacity: 1;
        }
    }
    
    /* Amélioration du scroll du menu si contenu trop long */
    #mobile-menu {
        max-height: calc(100vh - 6rem);
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
    }
    
    /* Styles pour écran très petit */
    @media (max-height: 600px) {
        #mobile-menu nav {
            padding: 1rem 1.5rem;
        }
        
        .mobile-nav-link {
            padding: 0.75rem 1rem;
        }
        
        .mobile-nav-icon {
            width: 2rem;
            height: 2rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const menuButton = document.getElementById('mobile-menu-button');
        const menuOverlay = document.getElementById('mobile-menu-overlay');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-nav-link');
        const body = document.body;
        
        function openMobileMenu() {
            body.classList.add('mobile-menu-open');
            menuButton.classList.add('menu-open');
            menuButton.setAttribute('aria-expanded', 'true');
            menuButton.setAttribute('aria-label', 'Fermer le menu de navigation');
            menuOverlay.setAttribute('aria-hidden', 'false');
            
            // Gérer le focus pour l'accessibilité
            mobileLinks.forEach(link => link.setAttribute('tabindex', '0'));
            if (mobileLinks.length > 0) {
                mobileLinks[0].focus();
            }
            
            // Empêcher le scroll du body
            body.style.overflow = 'hidden';
        }
        
        function closeMobileMenu() {
            body.classList.remove('mobile-menu-open');
            menuButton.classList.remove('menu-open');
            menuButton.setAttribute('aria-expanded', 'false');
            menuButton.setAttribute('aria-label', 'Ouvrir le menu de navigation');
            menuOverlay.setAttribute('aria-hidden', 'true');
            
            // Restaurer le focus et les tabindex
            mobileLinks.forEach(link => link.setAttribute('tabindex', '-1'));
            menuButton.focus();
            
            // Restaurer le scroll du body
            body.style.overflow = '';
        }
        
        menuButton.addEventListener('click', function() {
            const isOpen = body.classList.contains('mobile-menu-open');
            if (isOpen) {
                closeMobileMenu();
            } else {
                openMobileMenu();
            }
        });
        
        // Fermer le menu en cliquant sur l'overlay ou en dehors du menu
        menuOverlay.addEventListener('click', function(e) {
            // Fermer si on clique sur l'overlay ou en dehors du menu
            if (e.target === menuOverlay || !mobileMenu.contains(e.target)) {
                closeMobileMenu();
            }
        });
        
        // Fermer le menu en cliquant n'importe où sur la page quand le menu est ouvert
        document.addEventListener('click', function(e) {
            if (body.classList.contains('mobile-menu-open')) {
                // Ne pas fermer si on clique sur le bouton menu ou dans le menu
                if (!menuButton.contains(e.target) && !mobileMenu.contains(e.target)) {
                    closeMobileMenu();
                }
            }
        });
        
        // Fermer le menu après clic sur un lien
        mobileLinks.forEach(link => {
            link.addEventListener('click', function() {
                closeMobileMenu();
            });
        });
        
        // Fermer le menu avec la touche Échap
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape' && body.classList.contains('mobile-menu-open')) {
                closeMobileMenu();
            }
        });
        
        // Navigation au clavier dans le menu mobile
        mobileMenu.addEventListener('keydown', function(e) {
            const focusableElements = mobileMenu.querySelectorAll('a[tabindex="0"]');
            const currentIndex = Array.from(focusableElements).indexOf(document.activeElement);
            
            if (e.key === 'ArrowDown') {
                e.preventDefault();
                const nextIndex = (currentIndex + 1) % focusableElements.length;
                focusableElements[nextIndex].focus();
            } else if (e.key === 'ArrowUp') {
                e.preventDefault();
                const prevIndex = currentIndex <= 0 ? focusableElements.length - 1 : currentIndex - 1;
                focusableElements[prevIndex].focus();
            }
        });
    });
</script>