{
  "name": "violette-pogoda-website",
  "version": "1.0.0",
  "description": "Professional website for Violette Pogoda, freelance proofreader",
  "scripts": {
    "start": "npm-run-all -p dev:*",
    "build": "npm-run-all build:*",
    "dev:11ty": "eleventy --serve",
    "dev:css": "postcss src/styles/tailwind.css -o _site/css/styles.css --watch",
    "build:11ty": "eleventy",
    "build:css": "postcss src/styles/tailwind.css -o _site/css/styles.css"
  },
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "autoprefixer": "^10.4.17",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.1"
  }
}